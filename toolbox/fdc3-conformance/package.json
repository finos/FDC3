{
  "name": "@finos/fdc3-conformance",
  "version": "3.0.0-alpha.5",
  "description": "Static FDC3 conformance test site, local App Directory records, and a server to run them",
  "author": "Fintech Open Source Foundation (FINOS)",
  "type": "module",
  "homepage": "https://fdc3.finos.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finos/FDC3.git",
    "directory": "toolbox/fdc3-conformance"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "Apache-2.0",
  "bin": {
    "fdc3-conformance": "./bin/serve.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "copy": "shx mkdir -p ./dist && shx cp -R static/* ./dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && npm run copy && shx cp ../../node_modules/mocha/mocha.css ./dist/lib/mocha.css",
    "prepack": "npm run build",
    "serve": "node ./bin/serve.mjs",
    "start": "node ./bin/serve.mjs",
    "dev": "npm run clean && npm run build && npm run serve",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@finos/fdc3": "3.0.0-alpha.5",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "buffer": "^6.0.3",
    "chai": "^6.2.2",
    "events": "^3.3.0",
    "mocha": "^11.8.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "shx": "^0.4.0",
    "source-map-support": "^0.5.21",
    "stream-browserify": "^3.0.0",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
